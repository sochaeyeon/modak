<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.modak.address.mapper.AddressMapper">

	<!-- 배송지 추가 -->
	<insert id="insertAddress" parameterType="hashmap">
		INSERT INTO USER_ADDRESS (
		ADDRESS_ALIAS,
		ZIPCODE,
		ADDRESS,
		DETAILED_ADDRESS,
		DEFAULT_YN,
		USER_ID
		)
		VALUES (
		#{addressAlias},
		#{zipCode},
		#{address},
		#{detailedAddress},
		#{defaultYn},
		#{userId}
		)
	</insert>
	
	<!-- 배송지 목록 조회 -->
	<select id="selectAddressList" parameterType="hashmap" resultType="com.example.modak.address.model.Address">
			SELECT *
			FROM USER_ADDRESS
			WHERE USER_ID = #{userId};
	</select>
</mapper>

