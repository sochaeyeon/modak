<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.modak.event.mapper.EventMapper">

	<select id="selectEventList" parameterType="hashmap" resultType="com.example.modak.event.model.Event">
	SELECT * FROM EVENT

	</select>

	<select id="selectEvent" parameterType="hashmap" resultType="com.example.modak.event.model.Event">
	SELECT * FROM EVENT
	WHERE EVENT_ID = #{eventId}

	</select>

</mapper>