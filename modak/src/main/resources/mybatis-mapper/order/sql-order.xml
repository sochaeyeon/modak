<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.modak.order.mapper.OrderMapper">

    <resultMap id="orderDetailMap" type="com.example.modak.order.model.Order">
        <id property="orderId" column="ORDER_ID" />
        <result property="orderType"          column="ORDER_TYPE" />
        <result property="orderStatus"        column="ORDER_STATUS" />
        <result property="totalPrice"         column="TOTAL_PRICE" />
        <result property="discountAmt"        column="DISCOUNT_AMT" />
        <result property="createdAt"          column="CREATED_AT" />
        <result property="userId"             column="USER_ID" />
        <result property="receiverName"       column="RECEIVER_NAME" />
        <result property="receiverPhone"      column="RECEIVER_PHONE" />
        <result property="zipcode"            column="ZIPCODE" />
        <result property="deliveryAddr"       column="DELIVERY_ADDR" />
        <result property="deliveryDetailAddr" column="DELIVERY_DETAIL_ADDR" />
        <result property="payMethod"          column="PAY_METHOD" />
        <result property="payDate"            column="PAY_DATE" />

        <collection property="itemList"
                    javaType="java.util.ArrayList"
                    ofType="com.example.modak.order.model.OrderItem">
            <result property="productId"   column="PRODUCT_ID" />
            <result property="productName" column="PRODUCT_NAME" />
            <result property="price"       column="ITEM_PRICE" />
            <result property="count"       column="ITEM_COUNT" />
            <result property="orderType"   column="ITEM_TYPE" />
            <result property="startDate"   column="START_DATE" />
            <result property="endDate"     column="END_DATE" />
            <result property="imgUrl"      column="IMG_URL" />
        </collection>
    </resultMap>

    <resultMap id="orderListMap" type="com.example.modak.order.model.Order">
        <id property="orderId"     column="ORDER_ID" />
        <result property="orderType"   column="ORDER_TYPE" />
        <result property="orderStatus" column="ORDER_STATUS" />
        <result property="totalPrice"  column="TOTAL_PRICE" />
        <result property="discountAmt" column="DISCOUNT_AMT" />
        <result property="createdAt"   column="CREATED_AT" />
        <result property="userId"      column="USER_ID" />

        <collection property="itemList"
                    javaType="java.util.ArrayList"
                    ofType="com.example.modak.order.model.OrderItem">
            <id     property="itemId"      column="ITEM_ID" />
            <result property="productId"   column="PRODUCT_ID" />
            <result property="productName" column="PRODUCT_NAME" />
            <result property="price"       column="ITEM_PRICE" />
            <result property="count"       column="ITEM_COUNT" />
            <result property="startDate"   column="START_DATE" />
            <result property="endDate"     column="END_DATE" />
            <result property="imgUrl"      column="IMG_URL" />
        </collection>
    </resultMap>

    <!-- 주문 목록 -->
    <select id="selectOrderList" resultMap="orderListMap">
        SELECT
            O.ORDER_ID, O.ORDER_TYPE, O.ORDER_STATUS,
            O.TOTAL_PRICE, O.DISCOUNT_AMT, O.CREATED_AT, O.USER_ID,
            OI.ITEM_ID, OI.PRODUCT_ID,
            P.PRODUCT_NAME,
            OI.UNIT_PRICE  AS ITEM_PRICE,
            OI.QUANTITY    AS ITEM_COUNT,
            OI.START_DATE, OI.END_DATE,
            (SELECT PI.IMG_URL FROM PRODUCT_IMG PI
             WHERE PI.PRODUCT_ID = OI.PRODUCT_ID
             ORDER BY PI.IS_MAIN DESC LIMIT 1) AS IMG_URL
        FROM ORDERS O
        LEFT JOIN ORDER_ITEM OI ON O.ORDER_ID  = OI.ORDER_ID
        LEFT JOIN PRODUCT    P  ON OI.PRODUCT_ID = P.PRODUCT_ID
        WHERE O.USER_ID = #{userId}
        ORDER BY O.CREATED_AT DESC, OI.ITEM_ID ASC
    </select>

    <!-- 주문 상세 — 이미지 추가 + 결제시간 COALESCE fallback -->
    <select id="selectOrderDetail" resultMap="orderDetailMap">
        SELECT
            O.ORDER_ID, O.ORDER_TYPE, O.ORDER_STATUS,
            O.TOTAL_PRICE, O.DISCOUNT_AMT, O.CREATED_AT, O.USER_ID,

            U.USER_NAME  AS RECEIVER_NAME,
            U.USER_PHONE AS RECEIVER_PHONE,
            A.ZIPCODE,
            A.ADDRESS          AS DELIVERY_ADDR,
            A.DETAILED_ADDRESS AS DELIVERY_DETAIL_ADDR,

            /* ★ 결제수단 — payment_history 없으면 'CARD' fallback */
            COALESCE(PH.PAY_TYPE, 'CARD')      AS PAY_METHOD,
            /* ★ 결제시간 — payment 없으면 주문생성시간 fallback */
            COALESCE(PM.PAID_AT, O.CREATED_AT) AS PAY_DATE,

            P.PRODUCT_ID,
            P.PRODUCT_NAME,
            OI.UNIT_PRICE AS ITEM_PRICE,
            OI.QUANTITY   AS ITEM_COUNT,
            O.ORDER_TYPE  AS ITEM_TYPE,
            OI.START_DATE, OI.END_DATE,

            /* ★ 상품 대표 이미지 */
            (SELECT PI.IMG_URL FROM PRODUCT_IMG PI
             WHERE PI.PRODUCT_ID = P.PRODUCT_ID
               AND PI.IS_MAIN = 'Y'
             LIMIT 1) AS IMG_URL

        FROM ORDERS O
        INNER JOIN ORDER_ITEM OI ON O.ORDER_ID    = OI.ORDER_ID
        INNER JOIN PRODUCT    P  ON OI.PRODUCT_ID = P.PRODUCT_ID
        INNER JOIN USER       U  ON O.USER_ID     = U.USER_ID
        LEFT JOIN USER_ADDRESS    A  ON O.USER_ID = A.USER_ID AND A.DEFAULT_YN = 'Y'
        LEFT JOIN payment        PM  ON O.ORDER_ID = PM.ORDER_ID
        LEFT JOIN payment_history PH ON PM.PAY_ID  = PH.TARGET_PAY_ID
                                     AND PH.NEW_STATUS = 'PAID'
        WHERE O.ORDER_ID = #{orderId}
        <if test="userId != null and userId != ''">
            AND O.USER_ID = #{userId}
        </if>
    </select>

</mapper>