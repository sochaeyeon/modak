<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.modak.user.mapper.SignUpMapper">
	
	<!-- 회원가입 -->
	<insert id="insertUser" parameterType="hashmap">
		INSERT INTO USER(USER_ID, USER_PWD, USER_NAME, NICKNAME, USER_STATUS, EMAIL,
		CREATED_AT) VALUES( #{userId}, #{userPwd}, #{userName}, #{nickName}, 'ACTIVE',
		#{email}, NOW());
	</insert>
	
	<!-- 로그인 -->
	<select id="selectUser" parameterType="hashmap"
		resultType="com.example.modak.user.model.User">
		SELECT *
		FROM USER
		WHERE USER_ID = #{userId}
	</select>

</mapper>

