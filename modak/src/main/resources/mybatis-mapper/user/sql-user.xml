<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
   "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
   
<mapper namespace="com.example.modak.user.mapper.UserMapper">

	<!-- 회원 한 명 검색 -->
	<select id="selectUser" parameterType="hashmap" resultType="com.example.modak.user.model.User">
		SELECT *
		FROM USER
		WHERE USER_ID = #{userId}
	</select>

	<!-- 회원가입 -->
   <insert id="insertUser" parameterType="hashmap">
		INSERT INTO USER(USER_ID, USER_PWD, USER_NAME, NICKNAME, EMAIL) VALUES( #{userId}, #{userPwd}, #{userName}, #{nickName}, #{email});
   </insert>
</mapper>